import tkinter as tk

def f_to_c():
    f = float(fahrenheit_entry.get())
    c = (f - 32) * 5 / 9
    celsius_entry.delete(0, tk.END)
    celsius_entry.insert(0, format(c, ".2f"))

def c_to_f():
    c = float(celsius_entry.get())
    f = (c * 9 / 5) + 32
    fahrenheit_entry.delete(0, tk.END)
    fahrenheit_entry.insert(0, format(f, ".2f"))

root = tk.Tk()
root.title("Temperature Converter")

# Labels
tk.Label(root, text="Celsius").grid(row=0, column=0)
tk.Label(root, text="Fahrenheit").grid(row=0, column=1)

# Entry fields
celsius_entry = tk.Entry(root)
celsius_entry.grid(row=1, column=0)
celsius_entry.insert(0, "0.0")

fahrenheit_entry = tk.Entry(root)
fahrenheit_entry.grid(row=1, column=1)
fahrenheit_entry.insert(0, "32.0")

# Buttons
tk.Button(root, text=">>>>", command=f_to_c).grid(row=2, column=0)
tk.Button(root, text="<<<<", command=c_to_f).grid(row=2, column=1)

root.mainloop()